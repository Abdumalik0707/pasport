# Server
PORT=3000
NODE_ENV=production
# Ilova qaysi domenda ishlashi (faqat log xabari uchun)
PUBLIC_ORIGIN=https://example.com

# Admin panel API manzili (ariza shu yerga POST qilinadi)
ADMIN_API_URL=https://sizning-admin-panel-domeningiz/api/submissions
# Admin panel API kaliti (x-api-key header'i orqali yuboriladi)
ADMIN_API_KEY=

# Admin panel multipart so'rovda kutayotgan fayl maydon nomlari (ixtiyoriy,
# standart qiymatlar odatda yetarli — faqat admin panel boshqacha nom kutsa o'zgartiring)
ADMIN_API_FILE_FIELD_PHOTO=photo
ADMIN_API_FILE_FIELD_PASSPORT_SCAN=passport_scan
ADMIN_API_FILE_FIELD_DIPLOMA=diploma
ADMIN_API_FILE_FIELD_TRANSCRIPT=transcript

# Bitrix24 kiruvchi webhook manzili.
# Bitrix24 > Sozlamalar → Ilovalar → Webhook'lar → Kiruvchi webhook orqali oling.
# Format: https://<domen>.bitrix24.uz/rest/<user_id>/<webhook_kodi>/
BITRIX_WEBHOOK_URL=

# Ariza qaysi CRM manbasiga (SOURCE_ID) yozilishini belgilaydi (ixtiyoriy)
BITRIX_LEAD_SOURCE_ID=WEB

# Sdelka javobgar shaxs ID raqami (ixtiyoriy, bo'sh qoldirsa Bitrix default qiladi)
BITRIX_ASSIGNED_BY_ID=

# Ariza Bitrix24'da SDELKA (Deal) sifatida, aynan shu voronka (CATEGORY_ID) va
# bosqichda (STAGE_ID) yaratiladi. Qiymatlarni crm.category.list va
# crm.dealcategory.stage.list REST metodlari orqali bilib olish mumkin.
BITRIX_DEAL_CATEGORY_ID=1
BITRIX_DEAL_NEW_STAGE_ID=C1:NEW

# Bitrix24 CRM'da Sdelka (Deal) uchun ochilgan maxsus (User Field) matnli kodlar
# (akademiya.bitrix24.kz hisobida forma savollariga mos qilib yaratilgan).
BITRIX_DEAL_FIELD_BIRTH_DATE=UF_CRM_6AA16CBF040BE
BITRIX_DEAL_FIELD_CITIZENSHIP=UF_CRM_1789392308
BITRIX_DEAL_FIELD_ADDRESS=UF_CRM_1789392322
BITRIX_DEAL_FIELD_TELEGRAM=UF_CRM_1789392334
BITRIX_DEAL_FIELD_DOMESTIC_PASSPORT_NUMBER=UF_CRM_1789392344
BITRIX_DEAL_FIELD_DOMESTIC_PINFL=UF_CRM_1789392356
BITRIX_DEAL_FIELD_INTL_PASSPORT_NUMBER=UF_CRM_1789392367
BITRIX_DEAL_FIELD_INTL_PINFL=UF_CRM_1789392377
BITRIX_DEAL_FIELD_FATHER_NAME=UF_CRM_1789392390
BITRIX_DEAL_FIELD_FATHER_PHONE=UF_CRM_1789392399
BITRIX_DEAL_FIELD_MOTHER_NAME=UF_CRM_1789392413
BITRIX_DEAL_FIELD_MOTHER_PHONE=UF_CRM_1789392423

# Bitrix24 CRM'da Sdelka uchun ochilgan "Fayl" turidagi maxsus maydon kodlari
BITRIX_DEAL_FIELD_FILE_PHOTO=UF_CRM_1789392438
BITRIX_DEAL_FIELD_FILE_PASSPORT_SCAN=UF_CRM_1789392450
BITRIX_DEAL_FIELD_FILE_DIPLOMA=UF_CRM_1789392462
BITRIX_DEAL_FIELD_FILE_TRANSCRIPT=UF_CRM_1789392474

# Mahalliy zaxira ma'lumotlar bazasini (va yuklangan fayllarni) shifrlash uchun 32 baytli
# (64 ta hex belgi) maxfiy kalit. Bu kalit CSRF tokenlarini imzolash uchun ham ishlatiladi.
# Yaratish uchun: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY=

# Ariza yuborish limiti (bir IP uchun oynada nechta so'rov)
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=5
