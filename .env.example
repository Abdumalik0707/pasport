# Server
PORT=3000
NODE_ENV=production
# Ilova qaysi domenda ishlashi (faqat log xabari uchun)
PUBLIC_ORIGIN=https://example.com

# Admin panel API manzili (ariza shu yerga POST qilinadi)
ADMIN_API_URL=https://sizning-admin-panel-domeningiz/api/submissions
# Admin panel API kaliti (x-api-key header'i orqali yuboriladi)
ADMIN_API_KEY=

# Admin panel multipart so'rovda kutayotgan fayl maydon nomlari (ixtiyoriy,
# standart qiymatlar odatda yetarli — faqat admin panel boshqacha nom kutsa o'zgartiring)
ADMIN_API_FILE_FIELD_PHOTO=photo
ADMIN_API_FILE_FIELD_PASSPORT_SCAN=passport_scan
ADMIN_API_FILE_FIELD_DIPLOMA=diploma
ADMIN_API_FILE_FIELD_TRANSCRIPT=transcript

# Mahalliy zaxira ma'lumotlar bazasini (va yuklangan fayllarni) shifrlash uchun 32 baytli
# (64 ta hex belgi) maxfiy kalit. Bu kalit CSRF tokenlarini imzolash uchun ham ishlatiladi.
# Yaratish uchun: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY=

# Ariza yuborish limiti (bir IP uchun oynada nechta so'rov)
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=5
