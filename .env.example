# Server
PORT=3000
NODE_ENV=production
# Ilova qaysi domenda ishlashi (faqat log xabari uchun)
PUBLIC_ORIGIN=https://example.com

# Admin panel API manzili (ariza shu yerga POST qilinadi)
ADMIN_API_URL=https://sizning-admin-panel-domeningiz/api/submissions
# Admin panel API kaliti (x-api-key header'i orqali yuboriladi)
ADMIN_API_KEY=

# Admin panel multipart so'rovda kutayotgan fayl maydon nomlari (ixtiyoriy,
# standart qiymatlar odatda yetarli — faqat admin panel boshqacha nom kutsa o'zgartiring)
ADMIN_API_FILE_FIELD_PHOTO=photo
ADMIN_API_FILE_FIELD_PASSPORT_SCAN=passport_scan
ADMIN_API_FILE_FIELD_DIPLOMA=diploma
ADMIN_API_FILE_FIELD_TRANSCRIPT=transcript

# Bitrix24 kiruvchi webhook manzili.
# Bitrix24 > Sozlamalar → Ilovalar → Webhook'lar → Kiruvchi webhook orqali oling.
# Format: https://<domen>.bitrix24.uz/rest/<user_id>/<webhook_kodi>/
BITRIX_WEBHOOK_URL=

# Lead qaysi CRM manbasiga (SOURCE_ID) yozilishini belgilaydi (ixtiyoriy)
BITRIX_LEAD_SOURCE_ID=WEB

# Lead javobgar shaxs ID raqami (ixtiyoriy, bo'sh qoldirsa Bitrix default qiladi)
BITRIX_ASSIGNED_BY_ID=

# Bitrix24 CRM'da Lead uchun ochilgan maxsus (User Field) matnli kodlar.
# CRM > Lead > Maydonlarni sozlash bo'limida yarating, so'ng kodlarini shu yerga yozing.
# Bo'sh qoldirilsa, ma'lumot baribir yo'qolmaydi — "Izoh" (COMMENTS) maydoniga to'liq yoziladi.
BITRIX_FIELD_BIRTH_DATE=UF_CRM_BIRTH_DATE
BITRIX_FIELD_CITIZENSHIP=UF_CRM_CITIZENSHIP
BITRIX_FIELD_ADDRESS=UF_CRM_ADDRESS
BITRIX_FIELD_TELEGRAM=UF_CRM_TELEGRAM
BITRIX_FIELD_DOMESTIC_PASSPORT_NUMBER=UF_CRM_DOM_PASSPORT
BITRIX_FIELD_DOMESTIC_PINFL=UF_CRM_DOM_PINFL
BITRIX_FIELD_INTL_PASSPORT_NUMBER=UF_CRM_INTL_PASSPORT
BITRIX_FIELD_INTL_PINFL=UF_CRM_INTL_PINFL
BITRIX_FIELD_FATHER_NAME=UF_CRM_FATHER_NAME
BITRIX_FIELD_FATHER_PHONE=UF_CRM_FATHER_PHONE
BITRIX_FIELD_MOTHER_NAME=UF_CRM_MOTHER_NAME
BITRIX_FIELD_MOTHER_PHONE=UF_CRM_MOTHER_PHONE

# Bitrix24 CRM'da Lead uchun ochilgan "Fayl" turidagi maxsus maydon kodlari (hujjatlarni
# to'g'ridan-to'g'ri lead ichiga biriktirish uchun). Bo'sh qoldirilsa, fayllar Bitrix24'ga
# yuborilmaydi — ular baribir serverning mahalliy bazasida shifrlangan holda saqlanadi.
BITRIX_FIELD_FILE_PHOTO=UF_CRM_FILE_PHOTO
BITRIX_FIELD_FILE_PASSPORT_SCAN=UF_CRM_FILE_PASSPORT
BITRIX_FIELD_FILE_DIPLOMA=UF_CRM_FILE_DIPLOMA
BITRIX_FIELD_FILE_TRANSCRIPT=UF_CRM_FILE_TRANSCRIPT

# Mahalliy zaxira ma'lumotlar bazasini (va yuklangan fayllarni) shifrlash uchun 32 baytli
# (64 ta hex belgi) maxfiy kalit. Bu kalit CSRF tokenlarini imzolash uchun ham ishlatiladi.
# Yaratish uchun: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY=

# Ariza yuborish limiti (bir IP uchun oynada nechta so'rov)
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=5
